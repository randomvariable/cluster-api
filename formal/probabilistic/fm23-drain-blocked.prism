// fm23-drain-blocked.prism — DTMC model of FM-23 (drain blocked
// on PDB) with the upstream 5-minute drain timeout.
//
// State machine per CP machine:
//   draining ∈ {0, 1, 2, 3, 4}
//   0 = not draining
//   1..3 = drain in progress (PDB violation can stall here)
//   4 = drain succeeded (or force-deleted on timeout)
//
// Each step the drain progresses with probability p_progress, or
// stalls on a PDB violation with probability p_pdb_violation.
// After `drain_timeout` steps in any 1..3 state, force-delete fires
// and the machine moves to state 4. This is a coarse model — the
// finer-grained Lifecycle.qnt has explicit `drainBlocked` /
// `pdbViolatedFor` variables.

dtmc

const double p_progress = 0.70;
const double p_pdb_violation = 0.30;
const int    drain_timeout = 30;

module Machine1
    draining_1 : [0..4] init 0;
    waited_1   : [0..100] init 0;

    [tick] draining_1=0 -> 1.0 : (draining_1'=1) & (waited_1'=0);
    [tick] (draining_1>=1 & draining_1<=3 & waited_1<drain_timeout) ->
        p_progress : (draining_1'=draining_1+1) & (waited_1'=waited_1+1) +
        p_pdb_violation : (draining_1'=draining_1) & (waited_1'=waited_1+1);
    [tick] (draining_1>=1 & draining_1<=3 & waited_1>=drain_timeout) ->
        1.0 : (draining_1'=4) & (waited_1'=waited_1);          // force-delete
    [tick] draining_1=4 -> 1.0 : (draining_1'=4) & (waited_1'=waited_1);
endmodule

formula drained = (draining_1 = 4);
formula stuck_in_pdb = (draining_1 >= 1 & draining_1 <= 3 & waited_1 >= drain_timeout);
